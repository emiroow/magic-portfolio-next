# ------------------------------------------------------------------
# Magic Portfolio — environment template
# Copy to .env.local and fill in the values. Never commit .env.local.
# ------------------------------------------------------------------

# MongoDB connection string (local mongod or MongoDB Atlas)
MONGODB_URI="mongodb://localhost:27017/Magic"

# Canonical public URL of the site. Used for SEO, canonical/OG URLs and RSS.
# Development: http://localhost:3000 — Production: your real domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth (required). Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# Admin dashboard credentials (server-only; safe fallbacks exist for demos).
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="admin1234"

# Vercel Blob storage token — required for image uploads in production.
# BLOB_READ_WRITE_TOKEN=""

# Optional extras
# NEXT_PUBLIC_SITE_TITLE="My Portfolio"
# NEXT_PUBLIC_SITE_DESCRIPTION="Personal developer portfolio and blog"
# NEXT_PUBLIC_TWITTER_HANDLE="@username"
# NEXT_PUBLIC_GA_ID=""
